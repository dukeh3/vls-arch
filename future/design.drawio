      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="VLS Future Architecture — signer runs inside a security enclave; service-to-service NWC/NNC on an internal Nostr bus" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="zone-public" value="PUBLIC INTERNET — uncontrolled, adversarial by assumption" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="40" y="70" width="1320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="zone-dmz" value="DMZ — operator-controlled but public-facing; assume compromisable" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="40" y="250" width="1320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="zone-internal" value="INTERNAL — operator network; trusted ops but assume root-on-host possible" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="40" y="470" width="1320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="zone-enclave" value="ENCLAVE / TEE — hardware-attested isolation; opaque even to host root" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="40" y="710" width="1320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="end-user" value="End user&#xa;(browser / mobile / merchant POS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="80" y="120" width="240" height="80" as="geometry" />
